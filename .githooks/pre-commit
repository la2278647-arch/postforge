#!/bin/sh
# PostForge pre-commit 钩子：提交前自动运行测试，失败则阻止提交。
# 启用：git config core.hooksPath .githooks
# node 不在 PATH 时跳过测试（不阻止提交），并给出提示。

if ! command -v node >/dev/null 2>&1; then
  echo "⚠ node 不在 PATH，已跳过测试（请安装 Node.js ≥18 以获得完整质量保障）"
  exit 0
fi

echo "▶ 运行测试（pre-commit）..."
if node --test test/*.test.js >/dev/null 2>&1; then
  echo "✓ 测试通过"
  exit 0
else
  echo "✗ 测试失败，提交已阻止。请先修复：npm test"
  exit 1
fi
